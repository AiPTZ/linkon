PORT=3001
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
UNIPILE_DSN=
UNIPILE_ACCESS_TOKEN=
UNIPILE_WEBHOOK_SECRET=linkon-webhook-secret-change-me
WEBHOOK_PUBLIC_URL=
CREDENTIALS_ENCRYPTION_KEY=dev-encryption-key-change-me
FRONTEND_ORIGIN=http://localhost:5173

# Agendamento automático: app OAuth do Google (Calendar API) — obrigatório para o fluxo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/callback

# Fuso usado nos slots de reunião (ex.: America/Sao_Paulo)
APP_TIMEZONE=America/Sao_Paulo

# Segredo usado para assinar o JWT das sessões (mínimo 16 caracteres)
AUTH_SECRET=linkon-auth-secret-change-me

# Credencial do administrador (semeada no banco no primeiro boot)
ADMIN_USERNAME=arcanjo
ADMIN_PASSWORD=change-me-strong-password

# WhatsApp de suporte exibido no painel
WHATSAPP_SUPPORT=
