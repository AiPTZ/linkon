generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  passwordHash String
  whatsapp     String?
  role         String     @default("USER")
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  accounts     Account[]
  campaigns    Campaign[]
  extractions  Extraction[]
}

model Account {
  id               String     @id @default(cuid())
  unipileAccountId String     @unique
  provider         String     @default("LINKEDIN")
  username         String?
  authMethod       String     @default("NATIVE")
  status           String     @default("CONNECTING")
  checkpointType   String?
  credentialsEnc   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  userId           String?
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaigns        Campaign[]
  logs             LogEvent[]
  extractions      Extraction[]
  conversations    Conversation[]
}

model Campaign {
  id                   String     @id @default(cuid())
  name                 String
  mode                 String     @default("SEARCH")
  searchUrl            String
  status               String     @default("DRAFT")
  accountId            String
  account              Account    @relation(fields: [accountId], references: [id])
  inviteMessage        String     @default("")
  dailyLimit           Int        @default(40)
  weeklyLimit          Int        @default(150)
  minDelayMin          Int        @default(5)
  maxDelayMin          Int        @default(15)
  workStartHour        Int        @default(9)
  workEndHour          Int        @default(18)
  chatbotEnabled       Boolean    @default(false)
  chatbotRules         String     @default("[]")
  chatbotDefaultReply  String     @default("")
  chatbotReplyDelayMin Int        @default(1)
  chatbotReplyDelayMax Int        @default(3)
  chatbotStopKeywords  String     @default("[]")
  maxRepliesPerLead    Int        @default(3)
  chatbotMode          String     @default("RULES")
  chatbotKnowledgeBase String     @default("")
  chatbotTone          String     @default("consultivo e profissional")
  chatbotInitialMessageMode String @default("TEMPLATE")
  chatbotInitialTemplate   String @default("")
  chatbotTransferMessage   String @default("")
  chatbotMaxTurns          Int    @default(6)
  conversations        Conversation[]
  flow                 String     @default("")
  invitesSentToday     Int        @default(0)
  dateOfInviteCount    DateTime?
  invitesSentWeek      Int        @default(0)
  weekStartDate        DateTime?
  maxLeads             Int        @default(1000)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  userId               String?
  user                 User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  leads                Lead[]
  logs                 LogEvent[]
}

model Lead {
  id               String    @id @default(cuid())
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  providerId       String
  publicIdentifier String?
  name             String?
  headline         String?
  profileUrl       String?
  status           String    @default("PENDING")
  selected         Boolean   @default(false)
  invitedAt        DateTime?
  acceptedAt       DateTime?
  lastMessageAt    DateTime?
  lastMessageText  String?
  emails           String?
  phones           String?
  contactScrapedAt DateTime?
  nextInviteAt     DateTime?
  currentBlockId   String?
  replyCount       Int       @default(0)
  errorCode        String?
  createdAt        DateTime  @default(now())
  conversations    Conversation[]

  @@unique([campaignId, providerId])
  @@index([campaignId, status])
}

model Extraction {
  id           String    @id @default(cuid())
  name         String
  searchUrl    String
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  status       String    @default("PROCESSING")
  maxResults   Int       @default(250)
  totalFound   Int       @default(0)
  processed    Int       @default(0)
  withContact  Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  leads        ExtractedLead[]

  @@index([accountId])
  @@index([status])
}

model ExtractedLead {
  id               String     @id @default(cuid())
  extractionId     String
  extraction       Extraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  providerId       String
  publicIdentifier String?
  name             String?
  headline         String?
  profileUrl       String?
  emails           String?
  phones           String?
  socials          String?
  networkDistance  String?
  scrapedAt        DateTime?
  createdAt        DateTime   @default(now())

  @@unique([extractionId, providerId])
  @@index([extractionId])
}

model LogEvent {
  id         String    @id @default(cuid())
  campaignId String?
  leadId     String?
  accountId  String?
  type       String
  level      String    @default("INFO")
  message    String
  payload    String?
  createdAt  DateTime  @default(now())
  account    Account?  @relation(fields: [accountId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId, createdAt])
  @@index([createdAt])
}

model WebhookRegistration {
  id               String   @id @default(cuid())
  unipileWebhookId String   @unique
  source           String
  requestUrl       String
  createdAt        DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  accountId  String?
  campaignId String?
  type       String
  level      String    @default("INFO")
  message    String
  payload    String?
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([read])
}

model Conversation {
  id            String                @id @default(cuid())
  campaignId    String
  leadId        String
  accountId     String
  unipileChatId String                @unique
  status        String                @default("BOT")
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  campaign      Campaign              @relation(fields: [campaignId], references: [id])
  lead          Lead                  @relation(fields: [leadId], references: [id])
  account       Account               @relation(fields: [accountId], references: [id])
  messages      ConversationMessage[]

  @@index([campaignId])
  @@index([status])
  @@index([leadId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  messageId      String?
  tokensIn       Int?
  tokensOut      Int?
  costUsd        Float?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiEvaluationRun {
  id                String   @id @default(cuid())
  campaignId        String?
  name              String
  passRate          Float
  hallucinationRate Float
  transferRate      Float
  totalCases        Int
  passedCases       Int
  report            String?
  createdAt         DateTime @default(now())

  @@index([campaignId, createdAt])
}
