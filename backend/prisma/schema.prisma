generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id               String     @id @default(cuid())
  unipileAccountId String     @unique
  provider         String     @default("LINKEDIN")
  username         String?
  authMethod       String     @default("NATIVE")
  status           String     @default("CONNECTING")
  checkpointType   String?
  credentialsEnc   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  campaigns        Campaign[]
  logs             LogEvent[]
}

model Campaign {
  id                   String     @id @default(cuid())
  name                 String
  mode                 String     @default("SEARCH")
  searchUrl            String
  status               String     @default("DRAFT")
  accountId            String
  account              Account    @relation(fields: [accountId], references: [id])
  inviteMessage        String     @default("")
  dailyLimit           Int        @default(40)
  weeklyLimit          Int        @default(150)
  minDelayMin          Int        @default(5)
  maxDelayMin          Int        @default(15)
  workStartHour        Int        @default(9)
  workEndHour          Int        @default(18)
  chatbotEnabled       Boolean    @default(false)
  chatbotRules         String     @default("[]")
  chatbotDefaultReply  String     @default("")
  chatbotReplyDelayMin Int        @default(1)
  chatbotReplyDelayMax Int        @default(3)
  chatbotStopKeywords  String     @default("[]")
  maxRepliesPerLead    Int        @default(3)
  flow                 String     @default("")
  invitesSentToday     Int        @default(0)
  dateOfInviteCount    DateTime?
  invitesSentWeek      Int        @default(0)
  weekStartDate        DateTime?
  maxLeads             Int        @default(1000)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  leads                Lead[]
  logs                 LogEvent[]
}

model Lead {
  id               String    @id @default(cuid())
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  providerId       String
  publicIdentifier String?
  name             String?
  headline         String?
  profileUrl       String?
  status           String    @default("PENDING")
  selected         Boolean   @default(false)
  invitedAt        DateTime?
  acceptedAt       DateTime?
  lastMessageAt    DateTime?
  lastMessageText  String?
  nextInviteAt     DateTime?
  currentBlockId   String?
  replyCount       Int       @default(0)
  errorCode        String?
  createdAt        DateTime  @default(now())

  @@unique([campaignId, providerId])
  @@index([campaignId, status])
}

model LogEvent {
  id         String    @id @default(cuid())
  campaignId String?
  leadId     String?
  accountId  String?
  type       String
  level      String    @default("INFO")
  message    String
  payload    String?
  createdAt  DateTime  @default(now())
  account    Account?  @relation(fields: [accountId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId, createdAt])
  @@index([createdAt])
}

model WebhookRegistration {
  id               String   @id @default(cuid())
  unipileWebhookId String   @unique
  source           String
  requestUrl       String
  createdAt        DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  accountId  String?
  campaignId String?
  type       String
  level      String    @default("INFO")
  message    String
  payload    String?
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([read])
}
