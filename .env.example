# Link ON - variáveis de ambiente

# ---- Backend ----
# environment: development|production (em production o CORS é restrito a CORS_ORIGINS)
NODE_ENV=development
PORT=3001
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379

# Número de proxies reversos confiáveis para resolver o IP real do cliente
# (relevante para os rate limits quando atrás de Cloudflare/nginx). 1 = um hop.
TRUST_PROXY=1

# Origens permitidas no CORS (separadas por vírgula). Em NODE_ENV=production o
# backend só responde a essas origens; em development reflete a origem.
# Ex: https://app.linkon.com.br,https://admin.linkon.com.br
CORS_ORIGINS=

# ---- Rate limits (requisições por janela, por IP real) ----
# Login: janela de 60s
RATE_LIMIT_LOGIN_MAX=10
# Registro: janela de 15min
RATE_LIMIT_REGISTER_MAX=5
# API autenticada: janela de 60s
RATE_LIMIT_API_MAX=600
# Webhooks Unipile: janela de 60s
RATE_LIMIT_WEBHOOK_MAX=600

# Credenciais da Unipile (podem ser configuradas pelo painel em /configuracoes)
UNIPILE_DSN=
UNIPILE_ACCESS_TOKEN=

# Segredo usado para validar webhooks recebidos da Unipile (mínimo 8 caracteres)
UNIPILE_WEBHOOK_SECRET=linkon-webhook-secret-change-me

# URL pública do backend para registro de webhooks
# Ex: https://seu-dominio.com  ->  receberá eventos em https://seu-dominio.com/api/webhooks/unipile
WEBHOOK_PUBLIC_URL=

# Chave para criptografar credenciais das contas (mínimo 16 caracteres)
CREDENTIALS_ENCRYPTION_KEY=dev-encryption-key-change-me

# Origem do frontend (usada para montar links e para o CORS em production junto de CORS_ORIGINS)
FRONTEND_ORIGIN=http://localhost:5173

# Segredo usado para assinar o JWT das sessões (mínimo 16 caracteres)
AUTH_SECRET=linkon-auth-secret-change-me

# Credencial do administrador (semeada no banco no primeiro boot)
ADMIN_USERNAME=arcanjo
ADMIN_PASSWORD=change-me-strong-password

# WhatsApp de suporte exibido no painel
WHATSAPP_SUPPORT=

# Credenciais do LLM usado pelo chatbot IA (modo LLM). Chave própria do projeto.
# Deixe vazio para manter o chatbot em modo RULES (regras).
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini
