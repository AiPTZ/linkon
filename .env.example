# Link ON - variáveis de ambiente

# ---- Backend ----
PORT=3001
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379

# Credenciais da Unipile (podem ser configuradas pelo painel em /configuracoes)
UNIPILE_DSN=
UNIPILE_ACCESS_TOKEN=

# Segredo usado para validar webhooks recebidos da Unipile (mínimo 8 caracteres)
UNIPILE_WEBHOOK_SECRET=linkon-webhook-secret-change-me

# URL pública do backend para registro de webhooks
# Ex: https://seu-dominio.com  ->  receberá eventos em https://seu-dominio.com/api/webhooks/unipile
WEBHOOK_PUBLIC_URL=

# Chave para criptografar credenciais das contas (mínimo 16 caracteres)
CREDENTIALS_ENCRYPTION_KEY=dev-encryption-key-change-me

# Origem permitida no CORS (frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Segredo usado para assinar o JWT das sessões (mínimo 16 caracteres)
AUTH_SECRET=linkon-auth-secret-change-me

# Credencial do administrador (semeada no banco no primeiro boot)
ADMIN_USERNAME=arcanjo
ADMIN_PASSWORD=change-me-strong-password

# WhatsApp de suporte exibido no painel
WHATSAPP_SUPPORT=
